<?xml version="1.0" encoding="utf-8"?>
<!-- Production default: HTTPS only. Dev flavor overlays this to allow cleartext
     to a local/remote development API (see src/dev/res/xml/). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
